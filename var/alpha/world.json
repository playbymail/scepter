{
  "name": "alpha",
  "reviveRoom": 5,
  "monsterSpeed": 8,
  "descriptions": [
    {
      "record": 1,
      "lines": [
        "1/You are in the village square.# A dry fountain stands in the middle.#+/",
        "1/#Roads lead north and south; an inn lies east, a temple west.#/",
        "2/You are on the north road./You are on a rutted road north of the village./",
        "1/You are in the Gilded Goose.# Stairs climb to a loft; a newsstand is north.#/",
        "1/You are in the market.# A smithy smokes to the east; a pawnshop lies west.#/",
        "1/You are in the temple.# Candles burn before a plain stone altar.#/",
        "1/You are at the edge of a dark forest.# A ruined tower rises to the east.#/",
        "1/You are in the inn's loft.# It smells of hay and old wine.#/",
        "2/You are deep in the forest./You are among tall pines.# Something howls.#/",
        "1/You are at the foot of a ruined tower.# Steps climb into the dark.#/"
      ]
    },
    {
      "record": 2,
      "lines": [
        "1/You are atop the ruined tower.# The forest stretches out below.#/",
        "1/You are in a damp cellar.# Bones crunch underfoot.#/",
        "1/You are in a quiet glade.# A circle of white stones hums softly.#/",
        "1/You are on Guild Street.# Halls stand south and west; the market is north.#/",
        "1/You are at the east end of Guild Street.# Steps lead down to a cellar.#/",
        "1/You are in the fighters' hall.# Racks of blunted swords line the walls.#/",
        "1/You are in the barbarians' longhouse.# A fire roars in a long stone pit.#/",
        "1/You are in the rangers' lodge.# Antlers and bowstaves hang from the beams.#/",
        "1/You are in the mages' college.# Chalked circles cover the floor.#/",
        "1/You are in the thieves' den.# Nobody here looks at you directly.#/"
      ]
    },
    {
      "record": 3,
      "lines": [
        "2/A lean grey wolf, all ribs and teeth./A wolf with a torn ear./",
        "1/A goblin in a stolen helmet several sizes too big./",
        "1/A rat the size of a small dog./",
        "1/A skeleton held together by malice and old wire./",
        "1/A plain iron dagger, well oiled./",
        "1/An iron-bound chest with a brass lock./",
        "1/It reads: \"Tsogira reference world. Not for production.\"/",
        "1/A goblin in a cloak of crow feathers, muttering over a bundle of bones./"
      ]
    },
    {
      "record": 4,
      "lines": [
        "1/You are in the cloister.# Acolytes pace beneath the arches.#/",
        "1/You are in the paladins' chapter house.# Shields bear the temple's sign.#/",
        "1/You are in the pawnshop.# Shelves sag under other people's things.#/",
        "1/You are in the smithy.# The forge glows and a hammer rings on the anvil.#/",
        "1/You are at the newsstand.# Broadsheets flap from a line over the counter.#/"
      ]
    },
    {
      "record": 5,
      "lines": [
        "1/A peddler with a tray of trinkets slung from a strap about his neck./",
        "2/Help!  Thieves!/Guards!  Guards!/",
        "1/Take what you like, only spare me!/",
        "1/I'll not forget your face, friend./",
        "1/Is this how the village treats an honest trader?/",
        "2/Fine goods, cheap!/Everything must go!/",
        "1/The road north is no place to walk alone after dark./",
        "1/They say the old tower is full of goblins./",
        "1/I'd sell you another, but my tray is bare./",
        "1/Come back when I've restocked, friend./"
      ]
    }
  ],
