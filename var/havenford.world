# Havenford: original Scepter testing world, source format docs/world-format.md
# No encounters inside the city or on the approach to the warning post.
[world]
name = Havenford
start-room = 1
revive-room = 1
jail-room = 1
monster-speed = 4
notice = Welcome to Havenford. Guild Street is north of the square.
news-1 = Training halls stand north of Havenford Square.
news-2 = Roads north of the city remain safe through the frontier post.
news-3 = Beyond the warning sign, beasts wander in the meadow.
news-4 = The northwest Aether Observatory welcomes apprentice magic-users.
news-5 = The southwest keep offers locks, traps and ascending thief challenges.

[description 1]
1 = 1/You are in Havenford Refuge. The square and guild signs are east./
2 = 1/You are in Havenford Square. Guild Street is north; shops are south./
3 = 1/You are on Guild Street. Training halls flank the cobbled street./
4 = 1/You are in the Hall of Blades. Practice swords ring against shields./
5 = 1/You are in the Scout Lodge. Maps and unstrung bows cover the walls./
6 = 1/You are in the Academy of Sparks. Apprentices study quiet spells./
7 = 1/You are in the Lantern Chapel. The Graveward path leaves west./
8 = 1/You are in the Shadow School. Chalk marks outline a practice lock./
9 = 1/You are in the Hall of Stewards. Instructors teach worldcraft./
10 = 1/You are on Market Lane. A store lies east and a smithy west./

[description 2]
1 = 1/You are in the Provisioner. Food and basic gear fill wooden shelves./
2 = 1/You are in the Smithy. A friendly smith tests a repaired blade./
3 = 1/You are in the River Inn. Soup simmers in the common hearth./
4 = 1/You are at the Notice Kiosk. Fresh notices hang under an awning./
5 = 1/You are in the Exchange. A pawnbroker sorts simple trinkets./
6 = 1/You are in a public garden. Fruit trees shade a small fountain./
7 = 1/You are at Havenford North Gate. Guards wave travellers through./
8 = 1/You are on a calm road past the city walls. Farms lie north./
9 = 1/You are at the orchard crossroads. The city is south./
10 = 1/You are beside a quiet orchard. No danger seems close./

[description 3]
1 = 1/You are on a sunlit farm track. A milestone points north./
2 = 1/You are at the Frontier Warning Post. Read the sign before north./
3 = 1/You are in the meadow margin. Small tracks cross the grass./
4 = 1/You are in the willow meadow. A stream divides the reeds./
5 = 1/You are on a ferny trail. Rustling comes from the undergrowth./
6 = 1/You are at a shallow ford. The far bank rises into wooded hills./
7 = 1/You are at the old charcoal kiln. Ash covers the clearing./
8 = 1/You are among the low pine hills. Broken stone walls emerge./
9 = 1/You are at an abandoned campsite. A cold pot rests by the fire./
10 = 1/You are beside the ruined mill. Its wheel creaks in the wind./

[description 4]
1 = 1/You are on the ridge path. The old watchtower is visible north./
2 = 1/You are in the bracken ravine. A narrow pass climbs east./
3 = 1/You are at the tower approach. Loose stones shift underfoot./
4 = 1/You are in the outer tower yard. A broken bell hangs overhead./
5 = 1/You are inside the watchtower. Stairs climb into shadow./
6 = 1/You are in the watchtower loft. Wind whistles through the roof./
7 = 1/You are at the hill shrine. Smooth stones line a dry spring./
8 = 1/You are on the western sheep path. The pasture is quiet./
9 = 1/You are in the sheep pasture. The farmer smiles from a distance./
10 = 1/You are in the guild library. Books explain the roads ahead./

[description 5]
1 = 1/You are on the eastern promenade. The chapel is west./
2 = 1/You are at the training yard. The academy is west./

[description 6]
1 = 1/DANGER AHEAD! Monsters roam north of this post. Turn back if unready./
2 = 1/A kindly old caretaker gestures toward the nearby training halls./
3 = 1/A small rat snuffles among the roots./
4 = 1/A nervous crow hops from branch to branch./
5 = 1/A lean stray dog watches the path warily./
6 = 1/A fox with rust-colored fur stands in the grass./
7 = 1/A rough-looking highway thief grips a dull knife./
8 = 1/A battered skeleton stumbles through the ruined stones./
9 = 1/A hungry grey wolf peers from the brush./
10 = 1/An armored raider guards a crumbling stone passage./

[description 7]
1 = 1/A restless tower sentinel drags a dented spear./
2 = 1/A scarred bandit captain wears a faded blue cloak./
3 = 1/A carved wooden sign points south to the safety of Havenford./


# The Graveward: a safe western approach, then increasingly dangerous crypts.
[description 8]
1 = 1/You are in the Chapel Cloister. Graveward signs point west./
2 = 1/You are on the west pilgrim road. Quiet fields surround the path./
3 = 1/You are at the memorial garden. Names are carved on low stones./
4 = 1/You are at the Graveward Watch Post. The cemetery is west./
5 = 1/You stand at the Graveward Warning Gate. Read the posted warning./
6 = 1/You are among neglected graves. Loose bones shift in the soil./
7 = 1/You are on the cemetery path. A thin mist hangs above the stones./
8 = 1/You are beside an open grave. Something scrapes beneath the earth./
9 = 1/You are before an old mausoleum. Stone steps lead down./
10 = 1/You are in the mausoleum hall. Pale figures drift in the dark./

[description 9]
1 = 1/You are in the ossuary passage. Bone piles line the walls./
2 = 1/You are in the bone guard chamber. Ancient armor gleams faintly./
3 = 1/You are in the deepest crypt. A cold throne dominates the vault./
4 = 1/You are in a sealed side chapel. A silver bell hangs over an altar./
5 = 1/You are on the graveyard overlook. Havenford lies to the east./
6 = 1/UNDEAD AHEAD! West of this gate is unsafe. Clerics: return east to heal./
7 = 1/A brittle skeleton lurches forward with empty eye sockets./
8 = 1/A dim spirit wanders silently between the grave markers./
9 = 1/A grave guardian in rotted mail rises from the shadows./
10 = 1/A bone knight stands motionless with a notched sword./

[description 10]
1 = 1/A cold crypt wight points one skeletal finger at the living./
2 = 1/A votive silver token engraved with the chapel's sun emblem./
3 = 1/A polished shard of pale moonstone, cool in the palm./
4 = 1/A silver reliquary bearing a faded protective blessing./

