# ---- Northwest: the Aether Observatory (magic-user testing region) ----
# Reach it by going west from the Academy of Sparks (room 6).
# Rooms 79-83 and 91-93 are safe. The warning is in room 83.
# No wandering encounters until room 84. Encounters intensify farther northwest.
# Scepter has no scripted training dummies or spell puzzles in the world format.
# Instead, harmless side rooms demonstrate dark and anti-magic room flags.

[description 14]
1 = 1/You are on Scholar's Walk. A sign points west to the observatory./
2 = 1/You are in the arcane garden. Quiet lanterns float above the path./
3 = 1/You are at the novice colonnade. Lecture rooms stand east and south./
4 = 1/You are on the crystal causeway. The observatory looms west./
5 = 1/You are at the Aether Warning Gate. Danger lies north./
6 = 1/You are in the spark meadow. Weak magical motes flicker around you./
7 = 1/You are in the mirror thicket. Strange lights dart through the trees./
8 = 1/You stand before a shattered arch. Arcane echoes pulse beyond it./
9 = 1/You are in the broken observatory. Stairs spiral upward./
10 = 1/You are in the stargazer's loft. A broken telescope points skyward./

[description 15]
1 = 1/You are in the upper prism hall. Light scatters from cracked glass./
2 = 1/You are in the high aether chamber. Reality seems thin here./
3 = 1/You are in the spell library. Manuals teach safe magical practice./
4 = 1/You are in the darkened study. A lantern sits beside the door./
5 = 1/You are in the null-magic room. Enchantments fall silent here./
6 = 1/You are in the apprentice workshop. Test equipment covers the tables./
7 = 1/A small flickering mote drifts just above the ground./
8 = 1/A translucent sprite hums around a cluster of flowers./
9 = 1/A crackling spark elemental glows like a burning ember./
10 = 1/A shimmering mirror shade distorts the air around it./

[description 16]
1 = 1/A prismatic guardian stands between shards of colored glass./
2 = 1/A wild aether warden crackles with unstable magic./
3 = 1/DANGER AHEAD! Arcane creatures roam north. Return south to train./
4 = 1/A note reads: Dark rooms test light. Magic will fail in the null room./
5 = 1/An old apprentice's scroll, neatly marked with the heal spell./
6 = 1/A polished charm bearing the sigil of the observatory./
7 = 1/A blue crystal that pulses with stored energy./
8 = 1/A glass prism containing a faint sliver of starlight./

